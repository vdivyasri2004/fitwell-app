# FitWell mobile environment
# Copy to `.env` and set the URL of the local FitWell server.
# These are read at build time by Expo (EXPO_PUBLIC_* prefix).
#
# For the Expo web demo served on the same machine as the server, http://fitwell.local:4000 works.
# For a physical device, use your machine's LAN IP, e.g. http://192.168.1.10:4000
EXPO_PUBLIC_API_URL=http://fitwell.local:4000

# Optional: set to 1 to let the app attempt server-side AI generation
# (requires an AI provider configured on the server). Leave unset to use the
# built-in rule-based recommendations.
# EXPO_PUBLIC_AI_ENABLED=0
