# FitWell local server configuration (all optional; sensible defaults for local dev).

# Port the Express server listens on.
PORT=4000

# Path to the SQLite database file.
# FITWELL_DB_PATH=/fitwell/server/data/fitwell.db

# Secret used to sign JWT tokens. CHANGE THIS for anything beyond local dev.
# FITWELL_JWT_SECRET=change-me

# If you want optional server-side AI generation, provide a provider key here.
# FITWELL_AI_API_KEY=
